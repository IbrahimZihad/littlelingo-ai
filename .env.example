# Copy to .env and fill in. Never commit the filled-in file.
PORT=5000
NODE_ENV=development

# Optional. Without it Buddy answers from the built-in local helper, which is a
# fully working fallback rather than an error. Generate at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# How long to wait for the provider before answering from the local fallback.
# Successful replies on this account finish in 2.4-4.6s; longer budgets only make a
# child wait, they do not rescue the slow ones.
AI_TIMEOUT_MS=8000

# Requests per visitor per window across /api. Learning traffic is much chattier than
# the human browsing it represents, so keep this well above the interactive endpoints.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LEARNING_ACTIVITY_RATE_LIMIT_MAX_REQUESTS=240
HEALTH_RATE_LIMIT_MAX_REQUESTS=120

# Required when NODE_ENV=production. Signs session tokens; rotating it signs everyone
# out and invalidates every revoked token record. Use a fresh 32+ byte random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
AUTH_SECRET=

# Required. The app has no embedded database: it talks to a managed MySQL 8 server over
# TLS. Use the Service URI from the Aiven console as-is, including ?ssl-mode=REQUIRED —
# ssl-mode=DISABLED is refused rather than silently downgraded.
DATABASE_URL=mysql://service-user:password@host.aivencloud.com:16707/defaultdb

# Required to run `npm test`; the suite uses the same driver, TLS pinning and schema as
# the app. Point it at a database you are happy to have test rows written into — it
# seeds generated identifiers and deletes only those rows again.
TEST_DATABASE_URL=

# Pinned CA so TLS verifies the server rather than only encrypting it. Download "CA
# certificate" from the Aiven console and provide it either as a single-line PEM, base64
# of the PEM, or a path to the file — conventionally certs/aiven-ca.pem in the project
# root (a relative path resolves against the directory you run `npm start` from).
# AIVEN_CA_CERT wins if both are set. Aiven signs its certificates with its own CA, which
# no system trust store contains, so this is required in practice: without it the app
# refuses to connect rather than falling back to an unverified TLS session.
AIVEN_CA_CERT=
AIVEN_CA_CERT_FILE=certs/aiven-ca.pem

# Pooled connections per process. Keep the product of instances and this number inside
# the server's connection limit.
DATABASE_POOL_SIZE=5
